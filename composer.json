{
    "name": "croox/laravel-form-intercept",
    "description": "Intercept Laravel form emails containing test keywords and redirect them to a tech email address.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Croox",
            "email": "tech@croox.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "illuminate/mail": "^10.0 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Croox\\FormIntercept\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Croox\\FormIntercept\\FormInterceptServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
